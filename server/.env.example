DATABASE_URL=postgres://user:pass@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
NODE_ENV=development
PORT=3001

# Promote this user to admin on every boot. They must register via /liitu first.
ADMIN_EMAIL=

# Resend API key for sending registration confirmation emails.
# Leave blank in dev — emails are logged to the console instead.
# Get one at https://resend.com/
RESEND_API_KEY=
FROM_EMAIL="Drivers Club <onboarding@resend.dev>"
